<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"

        app:title="Paramètres"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator"
       />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARTE 1 : PROFIL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#2A2A2A"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROFIL"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#BB86FC"
                        android:layout_marginBottom="16dp"/>

                    <!-- Nom d'utilisateur -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nom d'utilisateur"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Entrez votre nom"
                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Thématique favorite -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thématique favorite"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/radioGroupTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/radioAnime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anime (ID: 16)"
                            android:textColor="#FFFFFF"
                            android:checked="true"/>

                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARTE 2 : API & STOCKAGE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#2A2A2A"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="API &amp; STOCKAGE"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#BB86FC"
                        android:layout_marginBottom="16dp"/>

                    <!-- Clé API -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clé API TMDB"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Clé API (optionnel)"
                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnSaveApi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Sauvegarder la clé"
                        android:backgroundTint="#BB86FC"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARTE 3 : DONNÉES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#2A2A2A"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <Button
                        android:id="@+id/btnClearData"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Supprimer toutes les données"
                        android:backgroundTint="#662222"
                        android:textColor="#FF6B6B"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Version -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AnimeTrack Otaku Edition v1.0"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>